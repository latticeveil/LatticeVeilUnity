<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>LatticeVeilMessages</AssemblyName>
    <RootNamespace>LatticeVeil.Messages</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyTitle>LatticeVeil Messages</AssemblyTitle>
    <Product>LatticeVeil</Product>

    <!-- One-exe deployment: everything bundled into LatticeVeilMessages.exe.
         Framework-dependent (uses the .NET 8 runtime already on the machine),
         no sidecar DLLs next to the launcher. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
