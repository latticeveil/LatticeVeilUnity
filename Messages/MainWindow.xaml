<Window x:Class="LatticeVeil.Messages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LatticeVeil Messages" Height="620" Width="940"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BgBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="ConvTemplate">
      <Border Padding="10,8" CornerRadius="8" Margin="4,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="36" Height="36">
            <Border CornerRadius="18" Background="#101512" Visibility="{Binding InitialVisible}">
              <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Ellipse Width="36" Height="36" Visibility="{Binding PictureVisible}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Picture}"/>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource AccentBrush}"
                  Padding="6,1" VerticalAlignment="Center" Visibility="{Binding UnreadVisible}">
            <TextBlock Text="{Binding UnreadText}" FontSize="12" FontWeight="ExtraBold" Foreground="Black"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Custom window-control buttons (no OS chrome) -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A221C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseWinBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Friend card for the Friends tab: profile like the launcher list -->
    <DataTemplate x:Key="FriendTemplate">
      <Border Padding="10,8" Margin="4,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="44" Height="44" VerticalAlignment="Top">
            <Border CornerRadius="22" Background="#101512" Visibility="{Binding InitialVisible}">
              <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Ellipse Width="44" Height="44" Visibility="{Binding PictureVisible}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Picture}"/>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,4,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="1" CornerRadius="9" Background="{StaticResource AccentBrush}"
                      Padding="6,1" Visibility="{Binding UnreadVisible}" Margin="6,0,0,0">
                <TextBlock Text="{Binding UnreadText}" FontSize="12" FontWeight="ExtraBold" Foreground="Black"/>
              </Border>
            </Grid>
            <!-- banner strip (only when the friend uploaded one) -->
            <Border CornerRadius="6" Height="46" Margin="0,6,0,0"
                    Visibility="{Binding BannerVisible}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Banner}" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
            <TextBlock Text="{Binding About}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                       Margin="0,6,0,0" Visibility="{Binding AboutVisible}"/>
            <TextBlock Text="💬 open chat" FontSize="12" Foreground="{StaticResource AccentBrush}"
                       Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Chats / Friends tab buttons -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A221C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#1E4A30" BorderThickness="1">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom title bar: draggable, no OS buttons -->
    <Border Grid.ColumnSpan="2" Grid.Row="0" Background="#050706" Height="38" Margin="-11,-11,-11,0"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Text="LATTICEVEIL MESSAGES" FontWeight="Bold" FontSize="12"
                     Foreground="{StaticResource AccentBrush}"/>
          <TextBlock x:Name="ConnText" Text="connecting…" Foreground="{StaticResource MutedBrush}"
                     FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="PinBtn" Content="📌" Style="{StaticResource WinBtn}" Click="PinBtn_Click"
                  ToolTip="Pin this window on top (stay open)"/>
          <Button x:Name="SoundBtn" Content="🔊" Style="{StaticResource WinBtn}" Click="SoundBtn_Click"
                  ToolTip="Toggle message sound"/>
          <Button x:Name="MinBtn" Content="—" Style="{StaticResource WinBtn}" Click="MinBtn_Click" ToolTip="Minimize"/>
          <Button Content="✕" Style="{StaticResource CloseWinBtn}" Click="CloseBtn_Click"
                  ToolTip="Close Messages — the launcher stays open"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Left: conversations -->
    <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Chats / Friends tabs — mirrors the website's messaging panel -->
        <Grid Margin="6,6,6,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="TabChatsBtn" Content="Chats" Style="{StaticResource TabBtn}"
                  FontWeight="Bold" Click="TabChats_Click"/>
          <Button x:Name="TabFriendsBtn" Grid.Column="1" Content="Friends" Style="{StaticResource TabBtn}"
                  FontWeight="Bold" Click="TabFriends_Click"/>
        </Grid>
        <!-- Chats tab -->
        <ScrollViewer x:Name="ChatsPane" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ListBox x:Name="ConvList" ItemsSource="{Binding Conversations}" ItemTemplate="{StaticResource ConvTemplate}"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="ConvList_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0E2417"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#1E4A30"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock x:Name="ConvEmpty" Text="No conversations yet — pick a friend in the launcher's Friends panel or start from the website."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="10" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
        <!-- Friends tab -->
        <ScrollViewer x:Name="FriendsPane" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <ListBox x:Name="FriendList" ItemTemplate="{StaticResource FriendTemplate}"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="FriendList_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0E2417"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="FriendsEmpty" Text="No friends yet — add friends from the launcher or the website."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="10" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Right: chat -->
    <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Margin="10,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat header: name + delete (trash) -->
        <Border x:Name="ChatHeader" Grid.Row="0" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChatTitle" Text="Select a conversation" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
            <Border x:Name="DelChatBtn" Grid.Column="1" Background="Transparent" CornerRadius="6"
                    Padding="8,3" Cursor="Hand" ToolTip="Delete chat — removes all messages for you and your friend"
                    MouseLeftButtonUp="DelChat_Click" VerticalAlignment="Center">
              <TextBlock Text="🗑" FontSize="14"/>
            </Border>
          </Grid>
        </Border>
        <!-- Inline delete confirmation (in place of the message area) -->
        <Border x:Name="DelConfirmPanel" Grid.Row="0" Grid.RowSpan="4" Background="#0C0F0DEE"
                Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="20">
            <TextBlock x:Name="DelConfirmText" Text="Delete this chat?" FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="All messages in this conversation will be removed for you and your friend. This cannot be undone."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="DelYesBtn" Content="Delete chat" Style="{StaticResource AccentBtn}" Padding="14,6"
                      Background="#B3261E" BorderBrush="#B3261E" Click="DelYes_Click"/>
              <Button x:Name="DelNoBtn" Content="Cancel" Style="{StaticResource AccentBtn}" Padding="14,6"
                      Margin="10,0,0,0" Click="DelNo_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="MsgScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
          <ItemsControl x:Name="MsgList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding Align}"
                            Margin="4,3" MaxWidth="520">
                  <Border Background="{Binding BubbleBrush}" BorderBrush="{Binding BubbleBorder}"
                          BorderThickness="1" CornerRadius="12" Padding="10,7">
                    <StackPanel MaxWidth="500">
                      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="14"/>
                      <TextBlock Text="{Binding Stamp}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                 HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="LoadOlderBtn" Grid.Row="1" Text="↑ load older" Foreground="{StaticResource AccentBrush}"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,6" Cursor="Hand"
                   MouseLeftButtonUp="LoadOlder_Click" Visibility="Collapsed"/>

        <!-- Cleared notice: shown inside the message area when the chat was
             emptied (this device or the peer). Sent messages still work. -->
        <TextBlock x:Name="ClearedText" Grid.Row="1" Text=""
                   Foreground="{StaticResource MutedBrush}" FontSize="12" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="12,10" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- Composer -->
        <Border Grid.Row="2" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MsgInput" Style="{StaticResource Input}" KeyDown="MsgInput_KeyDown"
                     MaxLength="2000" VerticalContentAlignment="Center"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="Send" Style="{StaticResource AccentBtn}"
                    Margin="8,0,0,0" Click="SendBtn_Click"/>
          </Grid>
        </Border>

        <TextBlock x:Name="ErrText" Grid.Row="3" Foreground="#FF6B6B" FontSize="12" Margin="12,4" TextWrapping="Wrap" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
